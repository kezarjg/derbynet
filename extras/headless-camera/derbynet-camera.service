[Unit]
Description=DerbyNet Headless Replay Camera
After=network.target

[Service]
Type=simple
User=derbynet
WorkingDirectory=/home/derbynet/derbynet/extras/headless-camera
ExecStart=/home/derbynet/derbynet/extras/headless-camera/venv/bin/python \
          /home/derbynet/derbynet/extras/headless-camera/headless_camera.py \
          --config /home/derbynet/derbynet/extras/headless-camera/config.yaml
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
